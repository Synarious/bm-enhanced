{
  "manifest_version": 3,
  "name": "Battlemetrics Enhanced",
  "description": "Modifies the RCON panel for Battlemetrics with enhancements and color coding.",
  "version": "4.3",
  "icons": {
    "128": "icons/icon.png"
  },
  "host_permissions": [
    "https://communitybanlist.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.battlemetrics.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.png"
      ],
      "matches": [
        "https://www.battlemetrics.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
